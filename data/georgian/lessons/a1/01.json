{
  "title": "მამა",
  "translation": "Dad",
  "topics": "The Georgian script, the five vowels ა ე ი ო უ and the letters მ ნ ლ რ ს",
  "interface": "english",
  "alphabet": true,
  "titles": {
    "grammar": "The letters",
