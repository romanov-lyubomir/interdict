  "reading": {
    "lang": "en",
    "text": [
      {
        "h": "A day in Tbilisi"
      },
      "Anna is in Tbilisi for the first time. Help her read what she sees.",
      "მეტრო · ტაქსი · აფთიაქი · რესტორანი · ბანკი",
      "In the restaurant: ხაჭაპური · ხინკალი · ღვინო · ჩაი · წყალი",
      "On the door: ღიაა 10:00–22:00"
    ],
    "exercises": [
      {
        "type": "choice",
        "prompt": "Read the text and choose.",
        "questions": [
          {
            "q": "Anna wants to take the underground. Which word does she look for?",
            "options": [
              "*მეტრო",
              "ტაქსი",
              "ბანკი"
            ]
          },
          {
            "q": "She has a headache. Where does she go?",
            "options": [
              "*აფთიაქი",
              "რესტორანი",
              "ბანკი"
            ]
          },
          {
            "q": "She is thirsty and doesn't drink alcohol. What does she order?",
            "options": [
              "*წყალი",
              "ღვინო",
              "ხინკალი"
            ]
          },
          {
            "q": "Is the place open at 9 in the evening?",
            "options": [
              "*Yes",
              "No"
            ]
          }
        ]
      }
    ]
