  "reading": {
    "text": [
      {
        "h": "Luka orders"
      },
      "მიმტანი: გამარჯობათ! რა გნებავთ?",
      "ლუკა: ერთი ყავა და ერთი ხაჭაპური, გთხოვთ.",
      "მიმტანი: ყავა რძით?",
      "ლუკა: არა, შავი, გთხოვთ. და ერთი წყალიც.",
      "…",
      "ლუკა: ძალიან გემრიელია! ანგარიში, გთხოვთ. რა ღირს?",
      "მიმტანი: თხუთმეტი ლარი.",
      "ლუკა: ინებეთ. მადლობა!"
    ],
    "exercises": [
