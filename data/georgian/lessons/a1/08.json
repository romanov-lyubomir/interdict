              "*ანგარიში, გთხოვთ.",
              "მინდა ყავა.",
              "ინებეთ."
            ]
          },
          {
            "q": "You want to know the price.",
            "options": [
              "*რა ღირს?",
              "რა გნებავთ?",
              "ყავა თუ ჩაი?"
            ]
          },
          {
            "q": "You give the money to the waiter.",
            "options": [
              "*ინებეთ.",
              "გთხოვთ.",
              "სასიამოვნოა."
            ]
          }
        ]
      },
      {
        "type": "gap",
        "prompt": "Complete the order.",
        "questions": [
          "[[მინდა]] ერთი ხაჭაპური. (I want)",
          "ორი ყავა, [[გთხოვთ]]. (please)",
          "ყავა [[თუ]] ჩაი? (or)",
          "რა [[ღირს]]? (how much)"
