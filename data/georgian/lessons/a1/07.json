{
  "title": "ეს ჩემი ოჯახია",
  "translation": "This is my family",
  "topics": "The family, my and your (*ჩემი, შენი*…), the numbers from 1 to 10, age, and *I have* (*მყავს*)",
  "interface": "english",
  "titles": {
    "grammar": "Grammar",
