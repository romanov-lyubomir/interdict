          ],
          [
            "τυρί",
            "tirí",
            "cheese"
          ],
          [
            "βροχή",
            "vrochí",
            "rain"
          ],
          [
            "χορός",
            "chorós",
            "dance"
          ]
        ],
        "lang": "el"
      }
    ]
  },
