                  "*-ità, -ezza*",
                  "facile → facil**ità**, bello → bell**ezza**"
                ],
                [
                  "verbo → possibilità",
                  "*-bile*",
                  "lavare → lava**bile**, leggere → leggi**bile**"
                ],
                [
                  "nome → mestiere, negozio",
                  "*-aio, -ista, -eria*",
                  "forno → forn**aio**, dente → dent**ista**, pizza → pizz**eria**"
