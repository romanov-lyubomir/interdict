                ],
                [
                  "dire, chiedere",
                  "comunicare, richiedere"
                ],
                [
                  "cominciare, finire",
                  "iniziare, terminare"
                ],
                [
                  "avere",
                  "disporre di"
                ],
                [
                  "per quanto riguarda…",
                  "in merito a…, in riferimento a…"
