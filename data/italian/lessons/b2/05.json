              "*{ip:mangia}",
              "{ip:mangiano}"
            ]
          },
          {
            "q": "Qui si ___ prodotti locali.",
            "options": [
              "{ip:vende}",
              "*{ip:vendono}"
            ]
          },
          {
            "q": "La mattina ___ {ip:alza} presto.",
            "options": [
              "si si",
              "*ci si",
              "si ci"
            ]
          }
        ]
      },
      {
        "type": "write",
        "prompt": "Make each sentence passive with essere.",
        "questions": [
          {
            "q": "La polizia {ip:ha} arrestato due uomini.",
            "a": [
