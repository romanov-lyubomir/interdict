      },
      {
        "type": "gap",
        "prompt": "Put the verb in the past with si.",
        "questions": [
          "Ieri [[si è mangiato#pp]] benissimo. (mangiare)",
          "A quella festa [[si è ballato#pp]] molto. (ballare)",
          "Con il treno [[si è arrivati#pp]] in orario. (arrivare)",
          "Finalmente [[si è venduta#pp]] la casa. (vendere)"
        ]
      }
    ]
  },
