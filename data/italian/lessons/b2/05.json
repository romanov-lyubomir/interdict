          {
            "q": "Questo modulo ___ compilato in stampatello. (must be)",
            "options": [
              "{ip:viene}",
              "*{ip:va}",
              "{ip:ha}"
            ]
          },
          {
            "q": "Il romanzo ___ pubblicato nel 1980.",
            "options": [
              "{ip:va}",
              "*{pp:è stato}",
              "{ip:ha}"
            ]
          },
          {
            "q": "In questo ristorante si ___ bene.",
