          {
            "q": "The novel is being translated into six languages.",
            "options": [
              "*True",
              "False"
            ]
          },
          {
            "q": "Critics say it should be read quickly.",
            "options": [
              "True",
              "*False"
            ]
          },
          {
            "q": "There has been talk of a film.",
            "options": [
              "*True",
              "False"
            ]
          }
        ]
      }
    ]
  },
