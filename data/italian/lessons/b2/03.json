              "{cst:foste stati}"
            ]
          },
          {
            "q": "{ip:È} il libro più bello che io ___ .",
            "options": [
              "{pp:ho letto}",
              "*{csa:abbia letto}",
              "{csi:leggessi}"
            ]
          }
        ]
      },
      {
