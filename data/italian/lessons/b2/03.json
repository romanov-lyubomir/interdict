          {
            "q": "{im:Credevo} che Anna ___ il giorno prima.",
            "options": [
              "{csp:parta}",
              "{csa:sia partita}",
              "*{cst:fosse partita}"
            ]
          },
          {
            "q": "{cop:Vorrei} che voi ___ qui adesso.",
            "options": [
              "{csp:siate}",
