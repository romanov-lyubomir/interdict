              "Ve li {ip:porto} domani."
            ],
            [
              "se ne",
              "Se ne {pp:è andato}."
            ],
            [
              "With infinitive",
              "Non {ip:voglio} parlartene."
            ],
            [
              "With tu command",
              "{imv:Portamene} due!"
            ],
            [
              "With Lei command",
              "Me ne {imv:porti} due!"
            ]
          ]
        }
      },
      {
        "h": "Ci and ne: beyond replacing words"
      },
      "In many everyday expressions, *ci* and *ne* no longer replace anything specific. They are part of the verb, and its meaning has to be learned as a whole.",
      {
        "table": {
          "head": [
            "Expression",
            "Meaning",
            "Example"
          ],
          "rows": [
            [
              "contarci",
              "to count on it",
              "Non contarci!"
            ],
            [
              "vederci",
              "to be able to see",
              "Non ci {ip:vedo} bene."
            ],
            [
              "sentirci",
