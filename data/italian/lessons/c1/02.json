          },
          {
            "q": "{ip:È} la persona più onesta che io ___ .",
            "options": [
              "{ip:conosco}",
              "*{csp:conosca}"
            ]
          },
          {
            "q": "Il libro che ___ {ip:è} molto bello.",
            "options": [
              "*{ip:sto} leggendo",
              "{csp:stia} leggendo"
            ]
          },
          {
            "q": "So che è vero, ma che ___ vero non basta.",
            "options": [
              "{ip:è}",
              "*{csp:sia}"
            ]
          },
          {
            "q": "___ cosa tu {csp:dica}, non ti {ip:credo}.",
            "options": [
              "*Qualunque",
              "Chiunque",
              "Comunque"
            ]
          }
        ]
      }
    ]
  },
