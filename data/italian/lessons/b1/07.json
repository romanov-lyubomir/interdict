            ]
          },
          {
            "q": "{pp:Hai dato} la lettera ad Anna? Sì, ___ .",
            "options": [
              "*gliel'{pp:ho data}",
              "le l'{pp:ho data}",
              "gliel'{pp:ho dato}"
            ]
          }
        ]
      }
    ]
  },
