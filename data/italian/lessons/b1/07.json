        "questions": [
          "[[Parli#imv]] piano, per favore. (parlare)",
          "[[Prenda#imv]] l'autobus. (prendere)",
          "[[Senta#imv]], {imv:scusi}! (sentire)",
          "[[Venga#imv]] qui! (venire)",
          "[[Faccia#imv]] attenzione! (fare)",
          "Mi [[dica#imv]]! (dire)"
        ]
      },
      {
        "type": "choice",
        "prompt": "Choose the right form.",
        "questions": [
          {
            "q": "Give it to me! (to a friend, a book)",
            "options": [
              "*{imv:Dammelo}!",
              "Me lo {imv:dia}!",
              "Me lo {imv:dai}!"
            ]
          },
          {
            "q": "Give it to me! (to a customer, a book)",
            "options": [
              "{imv:Dammelo}!",
              "*Me lo {imv:dia}!",
              "{imv:Dia} melo!"
            ]
          },
          {
            "q": "Voglio ___ . (say it to you)",
