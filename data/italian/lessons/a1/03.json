                    "l'amico",
                    "l'orologio"
                  ],
                  [
                    "**lo**",
                    "lo zaino",
                    "lo studente",
                    "lo specchio"
                  ],
                  [
                    "**la**",
                    "la sedia",
                    "la borsa",
                    "la finestra"
                  ],
                  [
                    "**l'**",
                    "l'aula",
                    "l'insegnante"
                  ]
                ],
                [
                  "plurale",
                  [
                    "**i**",
                    "i tavoli",
                    "i quaderni",
                    "i giornali"
                  ],
                  [
                    "**gli**",
                    "gli ombrelli",
                    "gli amici",
                    "gli orologi"
                  ],
                  [
                    "**gli**",
                    "gli zaini",
                    "gli studenti",
                    "gli specchi"
                  ],
                  [
                    "**le**",
                    "le sedie",
                    "le borse",
                    "le finestre"
                  ],
                  [
                    "**le**",
                    "le aule",
                    "le insegnanti"
                  ]
                ]
              ]
            },
            "note": [
              "**il** → **i**: parole maschili che cominciano con una consonante.",
              "**lo** → **gli**: parole maschili che cominciano con *s* + consonante, *z*, *ps* o *gn*, le stesse che prendono *uno*.",
              "**l'** → **gli**: parole maschili che cominciano con una vocale.",
              "**la** → **le**: parole femminili che cominciano con una consonante.",
              "**l'** → **le**: parole femminili che cominciano con una vocale."
            ]
          },
          {
