              "In the evening"
            ]
          },
          {
            "q": "Ahmed speaks…",
            "options": [
              "only Arabic",
              "*Arabic, French and some Italian",
              "Spanish"
            ]
          },
          {
            "q": "When he is tired, Ahmed…",
            "options": [
              "goes out",
              "studies",
              "*sleeps in front of the TV"
            ]
          }
        ]
      }
    ]
